@using Memoria.Web.Extensibility

@* Everything one stored event has to show, in the three views it is read through. Written once
   rather than per page: the same three facets are true of a streamed event and a DCB one, and they
   are read from the page the log opens a row on and from the sheet a model's events tab opens a
   row in — four places the same panels have to mean the same thing. What actually differs between
   them, which is how the log addresses the row, is named by the store and said in one place. *@

@* Views of one event, switched by the address rather than by script: each tab is a link, so a view
   can be linked to and gone back to, and the pages stay statically rendered. Marked with
   aria-current for the same reason a breadcrumb is — these are places to go, not scripted tabs.
   The three a model's page opens with, and no more: an event has no history of its own to list,
   nothing to compare, and nothing to update. *@
<nav class="tabs" aria-label="Event views">
    <a id="@TabId(InfoTab)" href="@TabLink(InfoTab)"
       aria-current="@Current(InfoTab)">Info</a>
    <a id="@TabId(StateTab)" href="@TabLink(StateTab)"
       aria-current="@Current(StateTab)">State</a>
    <a id="@TabId(JsonTab)" href="@TabLink(JsonTab)"
       aria-current="@Current(JsonTab)">Json</a>
</nav>

@* Each panel is named by the tab that reaches it, so the label is written once and a reader
   arriving by fragment is told which of them they landed in. *@
@if (Showing == InfoTab)
{
    <section class="tab-panel" aria-labelledby="@TabId(InfoTab)">
        @* The store's account of the row and nothing out of the payload: where it went, what it was
           filed as, what it was written under, and when. The same facts the table this was opened
           from leads with, in the same order, so a reader can match this against the row they
           clicked. *@
        <dl class="facts">
            @if (Streamed)
            {
                <dt>Stream Id</dt>
                <dd><code>@StreamId</code></dd>

                @* The key the store wrote the row under: the stream and the sequence joined, which
                   is what makes one event unique. Shown whole because it is the value that finds
                   the row again in the table. *@
                <dt>Id</dt>
                <dd><code>@Id</code></dd>
            }
            else
            {
                @* What the row was appended under, and the only thing it can be reached by: a DCB
                   event belongs to no stream, so its tags are what a boundary finds it through —
                   which is why they come first, where a streamed event's page puts the stream. A
                   row with none is said to have none rather than left blank: the log allows it, and
                   a blank reads as a fact that failed to fill rather than as an event nothing can
                   reach. *@
                <dt>Tags</dt>
                <dd>
                    @if (Event.Tags.Count == 0)
                    {
                        <span class="missing">it was appended under no tag</span>
                    }
                    else
                    {
                        <code>@string.Join(", ", Event.Tags)</code>
                    }
                </dd>
            }

            @* The key the row was written under, said the way a version is said rather than as the
               store joins it. Before where it sits, as a model's page puts its type before its
               version: what the row is, then where it is. *@
            <dt>Type</dt>
            <dd><code>@DomainTypeDescriber.LabelOfKey(Event.Type)</code></dd>

            @* Where the row sits, in the word each log counts by: a streamed event's number counts
               within its stream, which is why the stream stands above it and why it is a sequence
               — every stream has a first event. A DCB event is written into one log, so it has one
               number and no id beside it, and that number is its position. *@
            <dt>@(Streamed ? "Sequence" : "Position")</dt>
            <dd>@Event.Position@PositionNote</dd>

            <dt>Appended</dt>
            <dd>@Event.Written.ToLocalTime().ToString("g")</dd>

            @* Audit is a store concern the application may leave switched off, so a row nobody is
               named against is an ordinary row rather than a broken one. *@
            <dt>Appended by</dt>
            <dd>
                @if (Event.WrittenBy is { Length: > 0 } writtenBy)
                {
                    @writtenBy
                }
                else
                {
                    <span class="missing">not attributed</span>
                }
            </dd>
        </dl>
    </section>
}
else if (Showing == StateTab)
{
    <section class="tab-panel" aria-labelledby="@TabId(StateTab)">
        @if (Event.Error is not null)
        {
            @* The row is there and its payload will not open — a type nothing uploaded describes,
               or text the type cannot read. The Json tab still shows what was written. *@
            <p class="alert" role="alert">@Event.Error</p>
        }
        else if (Event.State.Count == 0)
        {
            <p class="missing">It carries nothing of its own.</p>
        }
        else
        {
            @* The same rows the types page lists the event's shape in, with the column this view
               has something to put in. *@
            <table class="grid">
                <thead>
                <tr>
                    <th scope="col">Property</th>
                    <th scope="col">Type</th>
                    <th scope="col">Value</th>
                </tr>
                </thead>
                <tbody>
                @StateRows((Event.State, 0))
                </tbody>
            </table>
        }
    </section>
}
else
{
    @* The payload as the store wrote it, laid out to be read. The state tab reads the same payload
       through the event's own properties; this shows the text those were read from, so a payload
       the type cannot open, or one holding more than the type declares, is still there to look
       at. The same card the pop-up over an event table holds, because it is the same question
       about the same row. *@
    <section class="tab-panel" aria-labelledby="@TabId(JsonTab)">
        <JsonPanel Data="@Event.Data"/>
    </section>
}

@code {

    /// <summary>
    /// The three views a stored event is read through, named as they appear in the address. Which
    /// one is showing is the address's to say, so a view can be linked to, bookmarked and gone back
    /// to — public because the pages build those addresses and match what comes back out of them,
    /// and a name spelled twice is a name that can drift.
    /// </summary>
    public const string InfoTab = "info";

    /// <summary>What the payload was read into, property by property.</summary>
    public const string StateTab = "state";

    /// <summary>The payload as the store wrote it.</summary>
    public const string JsonTab = "json";

    /// <summary>
    /// Matches a name from an address against the three there are, so an unknown one opens the view
    /// an event opens with rather than an empty panel.
    /// </summary>
    public static string Match(string? tab) => (tab ?? string.Empty).ToLowerInvariant() switch
    {
        StateTab => StateTab,
        JsonTab => JsonTab,
        _ => InfoTab
    };

    /// <summary>The stored row, as the store handed it back.</summary>
    [Parameter]
    [EditorRequired]
    public StoredEvent Event { get; set; } = null!;

    /// <summary>
    /// Which store wrote it, for how the row is addressed: a streamed event by the stream it was
    /// appended to and the key the store joined for it, a DCB event by its tags and its one
    /// position in the log.
    /// </summary>
    [Parameter]
    [EditorRequired]
    public ModelStore Store { get; set; }

    /// <summary>The stream a streamed event was appended to; null for a DCB event, which has none.</summary>
    [Parameter]
    public string? StreamId { get; set; }

    /// <summary>The key the streamed store wrote the row under, as <c>streamId:sequence</c>; null for a DCB event.</summary>
    [Parameter]
    public string? Id { get; set; }

    /// <summary>Which view to draw.</summary>
    [Parameter]
    [EditorRequired]
    public string Tab { get; set; } = InfoTab;

    /// <summary>
    /// Where each tab leads. Handed in rather than built here: the same three views are reached
    /// from two pages of the log and from two models' events tabs, and each of those has its own
    /// address to keep the rest of.
    /// </summary>
    [Parameter]
    [EditorRequired]
    public Func<string, string> TabLink { get; set; } = null!;

    /// <summary>
    /// What the tabs' own ids start with, so a sheet's row of them over a page with a row of its own
    /// does not claim the same three. Each panel is labelled by the tab that reaches it, and a
    /// duplicated id would have one of them labelled by the wrong one.
    /// </summary>
    [Parameter]
    public string Prefix { get; set; } = "tab";

    /// <summary>
    /// A note set beside the sequence or position, for a page that has something to say of where
    /// the row stands now — the event's own page does; a row opened in a model's history does not.
    /// </summary>
    [Parameter]
    public RenderFragment? PositionNote { get; set; }

    private string TabId(string tab) => $"{Prefix}-{tab}";

    private string Showing => Match(Tab);

    private string? Current(string tab) => Showing == tab ? "page" : null;

    private bool Streamed => Store == ModelStore.Streamed;

    /// <summary>
    /// What the stored event holds, a row each, with the insides of any value one holds in rows
    /// under it.
    /// </summary>
    /// <remarks>
    /// The same rows the types page lists the event's shape in, with the column this view has
    /// something to put in. A nested property keeps its own row so that its value stays under the
    /// value column, which is the column a reader came here for.
    /// </remarks>
    private RenderFragment<(IReadOnlyList<DomainPropertyValue> Properties, int Depth)> StateRows =>
        rows =>
        @<text>
            @foreach (var property in rows.Properties)
            {
                <tr class="@Under(rows.Depth)">
                    <td>@property.Name</td>
                    <td><code>@property.TypeName</code></td>
                    @* A value holding a shape has nothing of its own to show — what it holds is on
                       the rows below — so the cell is left as empty rather than as unread. *@
                    <td>@(property.Value ?? (property.Children.Count > 0 ? string.Empty : "—"))</td>
                </tr>

                @if (property.Children.Count > 0)
                {
                    @StateRows((property.Children, rows.Depth + 1))
                }
            }
        </text>;

    /// <summary>
    /// How far under something a row sits, as a class rather than a measurement, so how wide a step
    /// is stays the stylesheet's to say. A row at the top is not under anything and carries none.
    /// </summary>
    private static string? Under(int depth) => depth == 0 ? null : $"under-{Math.Min(depth, 3)}";

}

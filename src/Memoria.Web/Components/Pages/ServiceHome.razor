@page "/{service}"
@attribute [StreamRendering]
@using Memoria.Web.Data
@using Memoria.Web.Extensibility
@inject CurrentService Current
@inject StoreCapabilities Store
@inject ServiceActivity Activity

<PageTitle>@Current.Name</PageTitle>

<nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="">Home</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">@Current.Name</span>
</nav>

<h1>@Current.Name</h1>

@* Under the name, what the service is in its manifest's own words, when the manifest says — the
   same line Home draws under it — and nothing else. A sentence about which models it uses told
   a reader nothing the tiles below do not lay out better, and a service that says nothing of
   itself has its name and its tiles. *@
@if (Current.Service?.Description is { } description)
{
    <p class="lede">@description</p>
}

@* Laid out for the models the service has something registered under. Both: two columns, each
   headed by its model and the way into it. One alone: that model's tiles as the page, with no
   heading over them, because a heading names a choice and there is none to make. *@
@if (Shown.Both)
{
    <div class="models">
        <section class="model">
            <h2><a href="@At("streamed")">Streamed</a></h2>
            @StreamedTiles
        </section>

        <section class="model">
            <h2><a href="@At("dcb")">DCB</a></h2>
            @DcbTiles
        </section>
    </div>
}
else if (Shown.Streamed)
{
    @StreamedTiles
}
else
{
    @DcbTiles
}

@code {

    /// <summary>The service this page is: the first segment of its address.</summary>
    [Parameter]
    public string Service { get; set; } = string.Empty;

    private ShownModels Shown => ShownModels.Of(Current.Catalogue, Store);

    /// <summary>What the store holds of each streamed section, or null while it is being read or the model is not laid out.</summary>
    private ModelActivity? StreamedActivity { get; set; }

    /// <summary>The same of each DCB section.</summary>
    private ModelActivity? DcbActivity { get; set; }

    /// <summary>
    /// Asks the store what it holds of each model laid out, both at once: the tiles have been sent
    /// by the time this waits, and each model is read in a scope of its own.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        if (Current.Service is not { } service)
        {
            return;
        }

        var streamed = Shown.Streamed ? Activity.Streamed(service) : null;
        var dcb = Shown.Dcb ? Activity.Dcb(service) : null;

        StreamedActivity = streamed is null ? null : await streamed;
        DcbActivity = dcb is null ? null : await dcb;
    }

    private DomainTypeCatalogue Catalogue => Current.Catalogue;

    /// <summary>
    /// What the streamed model's Overview tile counts: the sum of the tiles under it — the events
    /// it applies, its aggregates, its projections and the streams the events are held in — so a
    /// reader adding the column up arrives at the number over it. The identifiers that address
    /// the models are not counted: no tile here is theirs, and a total that outran the tiles it
    /// heads read as a mistake.
    /// </summary>
    private int StreamedTypes =>
        Catalogue.StreamedEvents.Count + Catalogue.StreamedAggregates.Count
        + Catalogue.StreamedProjections.Count + Catalogue.StreamedStreamIds.Count;

    /// <summary>What the DCB model's Overview tile counts, the same way; a boundary has no streams to add.</summary>
    private int DcbTypes =>
        Catalogue.DcbEvents.Count + Catalogue.DcbAggregates.Count + Catalogue.DcbProjections.Count;

    /// <summary>An address under this service: the segment its name makes, then the page.</summary>
    private string At(string path) => $"{Current.Segment}/{path}";

    /// <summary>
    /// A count worded for a reader, the way every overview tile words one: the number and the
    /// noun, singular for one. Zero is said too — an empty section is a fact worth knowing
    /// before the door is opened.
    /// </summary>
    private static string Count(int count, string noun) =>
        count == 1 ? $"1 {noun}" : $"{count} {noun}s";

    // The same tiles the rest of the site is entered by, one under the other because a column is
    // half the page rather than the whole of it — and, alone, still one under the other, which is
    // how the overview under them lays its own out. Each names a section and goes to it; what is
    // under a section — the types the model declares and what has been stored of them — is on the
    // page the tile leads to, which is where a reader is asked to choose between them rather than
    // twice. Templates rather than components so the two layouts above draw the one markup.
    //
    // The Overview tile only while both models are laid out: it is the model's own page, the one
    // its heading here leads to, and with one model alone there is no heading and nothing for the
    // page to stand apart from — the sections it would count are the tiles beside it.
    private RenderFragment StreamedTiles =>
        @<ul class="tiles">
            @if (Shown.Both)
            {
            <li>
                <a href="@At("streamed")">
                    <SectionMark Kind="SectionKind.Overview"/>
                    <span class="body">
                        <span class="name">Overview</span>
                        <span class="detail">@Count(StreamedTypes, "type") registered under the streamed model.</span>
                    </span>
                </a>
            </li>
            }
            <li>
                <a href="@At("streamed/events")">
                    <SectionMark Kind="SectionKind.Events"/>
                    <span class="body">
                        <span class="name">Events</span>
                        <span class="detail">@Count(Catalogue.StreamedEvents.Count, "event") the model can apply.</span>
                        <SectionLine Model="@StreamedActivity" Section="@(model => model.Events)" Latest="Last event" Empty="No events yet"/>
                    </span>
                </a>
            </li>
            <li>
                <a href="@At("streamed/aggregates")">
                    <SectionMark Kind="SectionKind.Aggregates"/>
                    <span class="body">
                        <span class="name">Aggregates</span>
                        <span class="detail">@Count(Catalogue.StreamedAggregates.Count, "aggregate") the events are held in.</span>
                        <SectionLine Model="@StreamedActivity" Section="@(model => model.Aggregates)" Latest="Last written"/>
                    </span>
                </a>
            </li>
            <li>
                <a href="@At("streamed/projections")">
                    <SectionMark Kind="SectionKind.Projections"/>
                    <span class="body">
                        <span class="name">Projections</span>
                        <span class="detail">@Count(Catalogue.StreamedProjections.Count, "projection") built from those events.</span>
                        <SectionLine Model="@StreamedActivity" Section="@(model => model.Projections)" Latest="Last written"/>
                    </span>
                </a>
            </li>
            @* Last, and the one the DCB side has nothing to set against it: a boundary there is a
               query over tags rather than a place events are kept. *@
            <li>
                <a href="@At("streamed/streams")">
                    <SectionMark Kind="SectionKind.Streams"/>
                    <span class="body">
                        <span class="name">Streams</span>
                        <span class="detail">@Count(Catalogue.StreamedStreamIds.Count, "stream type") the events are held in.</span>
                        <SectionLine Model="@StreamedActivity" Section="@(model => model.Streams)" Noun="with events" Empty="No streams yet"/>
                    </span>
                </a>
            </li>
        </ul>;

    private RenderFragment DcbTiles =>
        @<ul class="tiles">
            @if (Shown.Both)
            {
            <li>
                <a href="@At("dcb")">
                    <SectionMark Kind="SectionKind.Overview"/>
                    <span class="body">
                        <span class="name">Overview</span>
                        <span class="detail">@Count(DcbTypes, "type") registered under the DCB model.</span>
                    </span>
                </a>
            </li>
            }
            <li>
                <a href="@At("dcb/events")">
                    <SectionMark Kind="SectionKind.Events"/>
                    <span class="body">
                        <span class="name">Events</span>
                        <span class="detail">@Count(Catalogue.DcbEvents.Count, "event") the model can apply.</span>
                        <SectionLine Model="@DcbActivity" Section="@(model => model.Events)" Latest="Last event" Empty="No events yet"/>
                    </span>
                </a>
            </li>
            <li>
                <a href="@At("dcb/aggregates")">
                    <SectionMark Kind="SectionKind.Aggregates"/>
                    <span class="body">
                        <span class="name">Aggregates</span>
                        <span class="detail">@Count(Catalogue.DcbAggregates.Count, "aggregate") the events are addressed by.</span>
                        <SectionLine Model="@DcbActivity" Section="@(model => model.Aggregates)" Latest="Last written"/>
                    </span>
                </a>
            </li>
            <li>
                <a href="@At("dcb/projections")">
                    <SectionMark Kind="SectionKind.Projections"/>
                    <span class="body">
                        <span class="name">Projections</span>
                        <span class="detail">@Count(Catalogue.DcbProjections.Count, "projection") the events are addressed by.</span>
                        <SectionLine Model="@DcbActivity" Section="@(model => model.Projections)" Latest="Last written"/>
                    </span>
                </a>
            </li>
        </ul>;

}

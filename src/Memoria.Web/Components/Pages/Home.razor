@page "/"
@attribute [StreamRendering]
@using System.Globalization
@using Memoria.Web.Data
@using Memoria.Web.Extensibility
@inject DomainTypeRegistry Types
@inject ServiceStores Stores
@inject ServiceAccess Access
@inject ServiceActivity Activity
@inject TimeProvider Clock
@inject Memoria.Web.Branding.BrandingStore Branding

@* Titled with the name the header shows, so a branded deployment's tab says what it is — or
   Home, when the header shows a logo alone. *@
<PageTitle>@(Branding.Current.HasName ? Branding.Current.Name : "Home")</PageTitle>

@* The header names the deployment already, so the page does not say it again over the list.
   The heading stays for a screen reader, which moves by headings: it names what the page lists. *@
<h1 class="visually-hidden">Services</h1>

@* The services installed that this operator may read, each the way into its own page. A service
   is a named set of domain assemblies read over one store, declared by the manifest in the zip
   that brought it; what a reader picks here is which one to read. Drawn as the tiles every
   section of the site is entered by, one a service, so the front door and the doors behind it
   are the same shape. *@
@if (Services.Count == 0)
{
    <p class="lede">
        No services are installed. A zip uploaded under
        <a href="settings">Settings</a> declares the services it brings, and each is listed here.
    </p>
}
else if (Visible.Count == 0)
{
    @* Silence is nobody: an operator whose sign-in carries nothing a manifest or the
       configuration names sees no service, and is told that is why, and who can change it —
       rather than a page that looks like a tool with nothing in it. *@
    <p class="lede">
        Nothing your sign-in carries names a service. A service is read by the operators its
        manifest names, or by anyone the tool's configuration maps to a role for every service.
        Ask whoever runs the service you were after, or whoever runs this tool, to name yours.
    </p>
}
else
{
    <p class="lede">
        The services installed, each a set of domain assemblies read over its own store. Pick one
        to read its events, and the aggregates and projections snapshotted from them.
    </p>

    @* One to a row: a service is read by its name and the sentence under it, and a sentence wants
       the measure the page gives prose, not the third of it a tile in a grid gets. *@
    <ul class="tiles services">
        @foreach (var service in Visible)
        {
            <li>
                @* Shown by the name the manifest wrote; reached by the address that name makes. *@
                <a href="@service.Slug">
                    <SectionMark Kind="SectionKind.Overview"/>
                    <span class="body">
                        <span class="head">
                            <span class="name">@service.Name</span>
                            @* Beside the name, for a store that can be reached: how much domain is
                               behind the door — the types registered, counted by kind, the empty
                               kinds left out. Each kind is its section's mark with the number
                               after it, the same mark the service's page enters that section by,
                               and the words are kept on the span for whoever cannot see the mark.
                               Nothing names a model; the service's own page lays those out. An
                               unreachable store counts nothing here: a count would suggest a door
                               that opens. *@
                            @if (Stores.For(service).Reachable)
                            {
                                <span class="facts">
                                    @foreach (var fact in Facts(Types.Current.For(service)))
                                    {
                                        <span class="fact" title="@fact.Label" aria-label="@fact.Label">
                                            @if (fact.Kind is { } kind)
                                            {
                                                <SectionMark Kind="kind"/>
                                            }
                                            @fact.Text
                                        </span>
                                    }
                                </span>
                            }
                        </span>
                        @* What the service is, in its manifest's own words, when the manifest
                           says. Not which models it registered under: every service said one of
                           three things there, which told a reader nothing its own page does not
                           lay out better. A store that cannot be reached is still said here,
                           first, where the person who can fix the configuration is looking. *@
                        @if (Detail(service) is { } detail)
                        {
                            <span class="detail">@detail</span>
                        }
                        @* What the store is doing, under what the service is: when its last event
                           was written, asked on every visit, and how many events it holds, counted
                           and kept a while — so the count says when it was made. The tiles are sent
                           before any store is asked, and these lines follow once every store has
                           answered or run out of patience, so the way into a service is never
                           behind a slow store. Nothing for a store that cannot be reached: the
                           line above already says why. *@
                        @if (Stores.For(service).Reachable)
                        {
                            <span class="activity">
                                @if (!Activities.TryGetValue(service.Slug, out var activity))
                                {
                                    <span class="reading">Reading the store…</span>
                                }
                                else if (activity.Problem is { } problem)
                                {
                                    <span class="problem">Could not read the store: @problem</span>
                                }
                                else
                                {
                                    @if (activity.LastEvent is { } last)
                                    {
                                        <span>Last event <time datetime="@last.UtcDateTime.ToString("O", CultureInfo.InvariantCulture)" title="@last.ToUniversalTime().ToString("u", CultureInfo.InvariantCulture)">@Ago.Since(last, Now)</time></span>
                                    }
                                    else
                                    {
                                        <span>No events yet</span>
                                    }
                                    @if (activity.Events is { } events && (events.Total > 0 || activity.LastEvent is not null))
                                    {
                                        <span title="Counted at @events.CountedAt.ToUniversalTime().ToString("u", CultureInfo.InvariantCulture)">@EventCount(events.Total), counted @Ago.Since(events.CountedAt, Now)</span>
                                    }
                                }
                            </span>
                        }
                    </span>
                </a>
            </li>
        }
    </ul>
}

@code {

    /// <summary>Who is asking, as the sign-in says; open, nobody, and everything is theirs to read.</summary>
    [CascadingParameter]
    public Task<AuthenticationState>? AuthenticationState { get; set; }

    private IReadOnlyList<Service> Services => Types.Current.Services;

    /// <summary>
    /// The services this operator may read — named by their manifest, or by a global role — by
    /// name, the same list in the same order the bar's Services menu folds.
    /// </summary>
    private IReadOnlyList<Service> Visible { get; set; } = [];

    protected override async Task OnInitializedAsync()
    {
        var user = AuthenticationState is { } state ? (await state).User : new System.Security.Claims.ClaimsPrincipal();

        Visible = Access.Readable(user, Services);

        // Every reachable store asked at once, each in a scope of its own, so the page waits for the
        // slowest store rather than for all of them one after another — and for no store longer
        // than the patience it is given.
        var reachable = Visible.Where(service => Stores.For(service).Reachable).ToList();
        var read = await Task.WhenAll(reachable.Select(service => Activity.Of(service)));

        Activities = reachable.Zip(read).ToDictionary(pair => pair.First.Slug, pair => pair.Second);
        Now = Clock.GetUtcNow();
    }

    /// <summary>What each reachable store is doing, by the service's slug; empty until the stores have answered.</summary>
    private IReadOnlyDictionary<string, StoreActivity> Activities { get; set; } = new Dictionary<string, StoreActivity>();

    /// <summary>When the stores answered, which every age on the page is measured from.</summary>
    private DateTimeOffset Now { get; set; }

    /// <summary>A number of events, worded for a reader.</summary>
    private static string EventCount(int total) =>
        total == 1 ? "1 event" : $"{total.ToString("N0", CultureInfo.CurrentCulture)} events";

    /// <summary>
    /// The line under a service's name: that its store cannot be reached, and why, before
    /// anything else; else what its manifest says it is; else nothing, and no line is drawn.
    /// </summary>
    private string? Detail(Service service) =>
        Stores.For(service).Problem is { } problem ? $"Unreachable: {problem}" : service.Description;

    /// <summary>
    /// One thing said beside a service's name: a kind's mark and the number registered under it,
    /// with the words the mark stands for kept for whoever cannot see it; or, with no mark, that
    /// nothing is registered at all.
    /// </summary>
    private sealed record Fact(SectionKind? Kind, string Text, string? Label);

    /// <summary>
    /// The types a service registered, counted by kind in the order its own page lays the sections
    /// out, with the kinds it registered none of left out; or that it registered none at all. The
    /// same numbers that page counts on its tiles, folded up: an aggregate or projection whichever
    /// model it is registered under, the streams the streamed model's events are held in, and an
    /// event once however many models apply it — and only if some model does. An event no model
    /// folds is declared and bound, but it is behind neither door, and counting it here made this
    /// row disagree with the page it leads to.
    /// </summary>
    private static IReadOnlyList<Fact> Facts(DomainTypeCatalogue catalogue)
    {
        var counted = new[]
            {
                Count(SectionKind.Events, catalogue.StreamedEvents.Union(catalogue.DcbEvents).Count(), "event"),
                Count(SectionKind.Aggregates, catalogue.StreamedAggregates.Count + catalogue.DcbAggregates.Count, "aggregate"),
                Count(SectionKind.Projections, catalogue.StreamedProjections.Count + catalogue.DcbProjections.Count, "projection"),
                Count(SectionKind.Streams, catalogue.StreamedStreamIds.Count, "stream")
            }
            .OfType<Fact>()
            .ToList();

        return counted.Count == 0 ? [new Fact(null, "no types registered", null)] : counted;
    }

    /// <summary>The count under a kind's mark, worded for a reader, or nothing when there is nothing to count.</summary>
    private static Fact? Count(SectionKind kind, int count, string noun) => count switch
    {
        0 => null,
        1 => new Fact(kind, "1", $"1 {noun}"),
        _ => new Fact(kind, count.ToString(), $"{count} {noun}s")
    };

}

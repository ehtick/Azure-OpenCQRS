@page "/{service}/streamed/events"
@attribute [StreamRendering]
@using Memoria.Web.Data
@using Memoria.Web.Extensibility
@inject CurrentService Current
@inject ServiceActivity Activity

<PageTitle>Streamed @Heading</PageTitle>

<nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="">Home</a>
    <span aria-hidden="true">/</span>
    <a href="@Service">@Current.Name</a>
    <span aria-hidden="true">/</span>
    <ModelCrumb Model="ModelStore.Streamed"/>
    <span aria-current="page">Events</span>
</nav>

<h1>@Heading</h1>

<SectionTiles TypesHref="@($"{Service}/streamed/events/types")" DataHref="@($"{Service}/streamed/events/data")">
    <TypesDetail>
        @Count(Catalogue.StreamedEvents.Count, "event") the model declares, and the state each one
        carries.
    </TypesDetail>
    <DataDetail>The events that have been appended, read one type at a time.</DataDetail>
    <DataActivity>
        <SectionLine Model="@Stored" Section="@(model => model.Events)" Latest="Last event" Empty="No events yet"/>
    </DataActivity>
</SectionTiles>

@code {

    /// <summary>The service this page sits under: the first segment of its address.</summary>
    [Parameter]
    public string Service { get; set; } = string.Empty;

    /// <summary>What the store holds of this section, or null while it is being read.</summary>
    private ModelActivity? Stored { get; set; }

    /// <summary>
    /// Asks the store what it holds of this section and no other; the tiles have been sent by the
    /// time this waits.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        if (Current.Service is { } service)
        {
            Stored = await Activity.Streamed(service, ModelSection.Events);
        }
    }

    /// <summary>
    /// What the page is, for the heading and the title. One value for both, so they cannot drift
    /// apart; the tab puts the section in front of it, because a tab is read away from the
    /// breadcrumb that says which section this is.
    /// </summary>
    private const string Heading = "Events";

    private DomainTypeCatalogue Catalogue => Current.Catalogue;

    private static string Count(int count, string noun) =>
        count == 1 ? $"1 {noun}" : $"{count} {noun}s";

}

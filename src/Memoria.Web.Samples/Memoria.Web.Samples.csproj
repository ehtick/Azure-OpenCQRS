<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Memoria.Web.Samples</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <!-- So the menu's questions can be answered from a test, where there is no keyboard to read
             a key from and no console to redirect. -->
        <InternalsVisibleTo Include="Memoria.Web.Samples.Tests" />
    </ItemGroup>

    <ItemGroup>
        <!-- The sample domain, one project per consistency model, so that either can be zipped and
             uploaded on its own: the tool lays itself out for the models it finds types under. -->
        <ProjectReference Include="..\Memoria.Web.Samples.Streamed\Memoria.Web.Samples.Streamed.csproj" />
        <ProjectReference Include="..\Memoria.Web.Samples.Dcb\Memoria.Web.Samples.Dcb.csproj" />
        <ProjectReference Include="..\Memoria\Memoria.csproj" />
        <ProjectReference Include="..\Memoria.EventSourcing\Memoria.EventSourcing.csproj" />
        <ProjectReference Include="..\Memoria.EventSourcing.Store.EntityFrameworkCore\Memoria.EventSourcing.Store.EntityFrameworkCore.csproj" />
        <ProjectReference Include="..\Memoria.EventSourcing.Store.Cosmos\Memoria.EventSourcing.Store.Cosmos.csproj" />
        <ProjectReference Include="..\Memoria.EventSourcing.Dcb\Memoria.EventSourcing.Dcb.csproj" />
        <ProjectReference Include="..\Memoria.EventSourcing.Dcb.Store.EntityFrameworkCore\Memoria.EventSourcing.Dcb.Store.EntityFrameworkCore.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Http" Version="2.3.13" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
        <!-- Pinned ahead of the provider's transitive version, which carries GHSA-2m69-gcr7-jv3q. -->
        <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    </ItemGroup>

    <ItemGroup>
        <!-- The tool's own provider resolution, so the seeder writes to whichever store the tool
             reads rather than assuming Postgres. Linked rather than referenced, so that nothing
             of the web application is built into the seeder. -->
        <Compile Include="..\Memoria.Web\Data\DatabaseProvider.cs" Link="Data\DatabaseProvider.cs" />
        <Compile Include="..\Memoria.Web\Data\DatabaseConnection.cs" Link="Data\DatabaseConnection.cs" />
        <Compile Include="..\Memoria.Web\Data\CosmosStore.cs" Link="Data\CosmosStore.cs" />
    </ItemGroup>

    <ItemGroup>
        <None Update="appsettings.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>

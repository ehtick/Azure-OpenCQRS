source "https://rubygems.org"

# Exactly what GitHub Pages runs, so a local preview matches the deployed site:
# github-pages 232 pins Jekyll 3.10.0 and every plugin Pages enables by default.
# Two of those defaults matter here — jekyll-relative-links rewrites the `.md`
# links the pages are written with, and jekyll-optional-front-matter tolerates a
# page without any. Running plain Jekyll instead would show broken links that
# work in production.
#
# The version GitHub is running is at https://pages.github.com/versions.json.
gem "github-pages", "~> 232", group: :jekyll_plugins

# The theme is fetched by jekyll-remote-theme from the tag named in _config.yml,
# so it is not listed here.

# Removed from Ruby's standard library in 3.0, and `jekyll serve` needs it.
gem "webrick", "~> 1.8"

# Windows and JRuby do not include zoneinfo files.
platforms :mingw, :x64_mingw, :mswin, :jruby do
  gem "tzinfo", ">= 1", "< 3"
  gem "tzinfo-data"
end

# Faster directory watching on Windows. 0.2 is the first release that builds
# against Ruby 3, so do not relax this to "~> 0.1".
gem "wdm", "~> 0.2", platforms: [:mingw, :x64_mingw, :mswin]

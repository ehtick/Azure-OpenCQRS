@page "/admin/products"
@layout AdminLayout
@using Memoria
@using Memoria.Examples.Ecommerce.Dcb.Queries
@using Memoria.Examples.Ecommerce.Dcb.ReadModels
@inject IDispatcher Dispatcher

<PageTitle>Products</PageTitle>

<nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="admin">Overview</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">Products</span>
</nav>

<div class="page-header">
    <div>
        <h1>Products</h1>
        <p class="lede">@Summary</p>
    </div>
    <a class="button" href="admin/products/create">Add product</a>
</div>

@* A plain GET form: searching is a link to a narrower list, so it belongs in the address bar
   where it can be bookmarked, shared and gone back to. The sort travels in hidden fields so
   finding something does not silently reorder it. *@
@if (error is not null)
{
    <p class="alert" role="alert">@error</p>
}

<form class="search" method="get" action="admin/products">
    <label class="visually-hidden" for="q">Search products</label>
    <input id="q" type="search" name="q" value="@search" placeholder="Search name or SKU" autocomplete="off"/>
    <input type="hidden" name="sort" value="@KeyOf(sort)"/>
    <input type="hidden" name="dir" value="@(descending ? "desc" : "asc")"/>
    <input type="hidden" name="size" value="@pageSize"/>
    <button type="submit">Search</button>
    @if (IsFiltered)
    {
        <a href="@Link(sort, descending, 1, clearSearch: true)">Clear</a>
    }
</form>

@if (products.Count == 0)
{
    <p class="empty">
        @if (IsFiltered)
        {
            <text>No products match &ldquo;@search&rdquo;.</text>
        }
        else
        {
            <text>Nothing in the catalogue yet. Add your first product to see it here.</text>
        }
    </p>
}
else
{
    <table>
        <thead>
        <tr>
            @foreach (var column in Columns)
            {
                <th class="@(column.Numeric ? "numeric" : null)" aria-sort="@AriaSort(column.Sort)">
                    <a href="@SortLink(column.Sort)">
                        @column.Label
                        @if (sort == column.Sort)
                        {
                            <span class="arrow @(descending ? "down" : "up")" aria-hidden="true"></span>
                        }
                    </a>
                </th>
            }
            <th><span class="visually-hidden">Actions</span></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var product in products)
        {
            <tr>
                <td class="name">@product.Name</td>
                <td class="sku">@product.Sku</td>
                <td class="numeric">@product.Price.ToString("C")</td>
                <td class="muted">@product.CreatedDate.ToLocalTime().ToString("g")</td>
                <td class="muted">@product.UpdatedDate.ToLocalTime().ToString("g")</td>
                <td class="actions">
                    <a href="@ActionLink(product.ProductId, "edit")">Edit</a>
                    <a class="delete" href="@ActionLink(product.ProductId, "delete")">Delete</a>
                </td>
            </tr>
        }
        </tbody>
    </table>

    <div class="table-footer">
        <div class="pagination">
            @if (TotalPages > 1)
            {
                @if (CurrentPage > 1)
                {
                    <a href="@Link(sort, descending, CurrentPage - 1)">Previous</a>
                }
                else
                {
                    <span class="disabled">Previous</span>
                }

                <span>Page @CurrentPage of @TotalPages</span>

                @if (CurrentPage < TotalPages)
                {
                    <a href="@Link(sort, descending, CurrentPage + 1)">Next</a>
                }
                else
                {
                    <span class="disabled">Next</span>
                }
            }
        </div>

        @* Its own GET form, so the choice lands in the address bar like the order and the
           search term. Submitting on change saves a click; the button is the fallback when
           scripting is off. *@
        <form class="page-size" method="get" action="admin/products">
            <label for="size">Rows per page</label>
            <select id="size" name="size" onchange="this.form.submit()">
                @foreach (var option in PageSizes)
                {
                    <option value="@option" selected="@(option == pageSize)">@option</option>
                }
            </select>
            <input type="hidden" name="sort" value="@KeyOf(sort)"/>
            <input type="hidden" name="dir" value="@(descending ? "desc" : "asc")"/>
            @if (IsFiltered)
            {
                <input type="hidden" name="q" value="@search"/>
            }
            <noscript>
                <button type="submit">Apply</button>
            </noscript>
        </form>
    </div>
}

@code {
    private const int DefaultPageSize = 10;

    /// <summary>
    /// The sizes on offer. Also the allowlist: the value arrives from the address bar, and
    /// anything outside this set would let a caller ask for the whole table in one query.
    /// </summary>
    private static readonly int[] PageSizes = [10, 25, 50, 100];

    /// <summary>
    /// The columns, their query-string keys and their headings — one place, so the header row and
    /// the sort links cannot disagree about what is sortable.
    /// </summary>
    private static readonly Column[] Columns =
    [
        new(ProductSort.Name, "name", "Name", Numeric: false),
        new(ProductSort.Sku, "sku", "SKU", Numeric: false),
        new(ProductSort.Price, "price", "Price", Numeric: true),
        new(ProductSort.CreatedDate, "created", "Created", Numeric: false),
        new(ProductSort.UpdatedDate, "updated", "Updated", Numeric: false)
    ];

    private IReadOnlyList<ProductListItem> products = [];

    private int totalCount;

    private ProductSort sort = ProductSort.CreatedDate;

    private bool descending = true;

    private string? search;

    private string? error;

    private int pageSize = DefaultPageSize;

    // Bound as text, not as int?: Blazor throws when a query value will not parse into the
    // declared type, and these come from the address bar where anything can appear. Parsing
    // them here turns a 500 into a sensible default.
    [SupplyParameterFromQuery(Name = "page")]
    private string? PageNumber { get; set; }

    [SupplyParameterFromQuery(Name = "sort")]
    private string? SortKey { get; set; }

    [SupplyParameterFromQuery(Name = "dir")]
    private string? Direction { get; set; }

    [SupplyParameterFromQuery(Name = "q")]
    private string? Query { get; set; }

    [SupplyParameterFromQuery(Name = "size")]
    private string? Size { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    private string? DeleteError { get; set; }

    private int CurrentPage => int.TryParse(PageNumber, out var page) && page > 0 ? page : 1;

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(totalCount / (double)pageSize));

    private bool IsFiltered => !string.IsNullOrWhiteSpace(search);

    private string Summary => (IsFiltered, totalCount) switch
    {
        (true, 1) => $"1 product matching “{search}”.",
        (true, var count) => $"{count} products matching “{search}”.",
        (false, 1) => "1 product in the catalogue.",
        (false, var count) => $"{count} products in the catalogue."
    };

    protected override async Task OnInitializedAsync()
    {
        // Anything unrecognised falls back to newest first rather than failing: these values come
        // from the address bar, where they can be anything at all.
        var column = Columns.FirstOrDefault(candidate =>
            string.Equals(candidate.Key, SortKey, StringComparison.OrdinalIgnoreCase));

        sort = column?.Sort ?? ProductSort.CreatedDate;
        descending = column is null || string.Equals(Direction, "desc", StringComparison.OrdinalIgnoreCase);
        search = string.IsNullOrWhiteSpace(Query) ? null : Query.Trim();
        error = string.IsNullOrWhiteSpace(DeleteError) ? null : DeleteError;
        pageSize = int.TryParse(Size, out var requested) && PageSizes.Contains(requested)
            ? requested
            : DefaultPageSize;

        var result = await Dispatcher.Get(new GetProductsQuery(CurrentPage, pageSize, sort, descending, search));

        if (result.Value is not { } page)
        {
            return;
        }

        products = page.Products;
        totalCount = page.TotalCount;
    }

    /// <summary>
    /// The active column flips direction; any other column starts ascending. Returns to page one,
    /// because a page number counted in one order means nothing in another.
    /// </summary>
    private string SortLink(ProductSort column) =>
        Link(column, sort == column && !descending, 1);

    /// <summary>
    /// Every link out of this page carries the whole view — order, page, search term and page
    /// size — so none of them quietly drops one of the four.
    /// </summary>
    private string Link(ProductSort column, bool sortDescending, int page, bool clearSearch = false)
    {
        var parts = new List<string> { $"sort={KeyOf(column)}", $"dir={(sortDescending ? "desc" : "asc")}" };

        if (page > 1)
        {
            parts.Add($"page={page}");
        }

        if (!clearSearch && IsFiltered)
        {
            parts.Add($"q={Uri.EscapeDataString(search!)}");
        }

        if (pageSize != DefaultPageSize)
        {
            parts.Add($"size={pageSize}");
        }

        return $"admin/products?{string.Join("&", parts)}";
    }

    private static string KeyOf(ProductSort column) =>
        Columns.First(candidate => candidate.Sort == column).Key;

    /// <summary>
    /// Editing and deleting both leave the list, so both are told where to come back to: the order,
    /// page, search and size survive the round trip, whether the visitor saves, deletes or cancels.
    /// </summary>
    private string ActionLink(string productId, string action) =>
        $"admin/products/{productId}/{action}?returnUrl={Uri.EscapeDataString("/" + Link(sort, descending, CurrentPage))}";

    private string AriaSort(ProductSort column) =>
        sort != column ? "none" : descending ? "descending" : "ascending";

    private sealed record Column(ProductSort Sort, string Key, string Label, bool Numeric);
}

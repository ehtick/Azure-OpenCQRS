@page "/admin/products"
@layout AdminLayout
@using Memoria
@using Memoria.Examples.Ecommerce.Dcb.Queries
@using Memoria.Examples.Ecommerce.Dcb.ReadModels
@inject IDispatcher Dispatcher

<PageTitle>Products</PageTitle>

<nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="admin">Overview</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">Products</span>
</nav>

<div class="page-header">
    <div>
        <h1>Products</h1>
        <p class="lede">@Summary</p>
    </div>
    <a class="button" href="admin/products/create">Add product</a>
</div>

@if (products.Count == 0)
{
    <p class="empty">Nothing in the catalogue yet. Add your first product to see it here.</p>
}
else
{
    <table>
        <thead>
        <tr>
            <th>Name</th>
            <th>SKU</th>
            <th class="numeric">Price</th>
            <th>Created</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var product in products)
        {
            <tr>
                <td class="name">@product.Name</td>
                <td class="sku">@product.Sku</td>
                <td class="numeric">@product.Price.ToString("C")</td>
                <td class="muted">@product.CreatedDate.ToLocalTime().ToString("g")</td>
            </tr>
        }
        </tbody>
    </table>

    @if (TotalPages > 1)
    {
        <div class="pagination">
            @if (CurrentPage > 1)
            {
                <a href="@PageLink(CurrentPage - 1)">Previous</a>
            }
            else
            {
                <span class="disabled">Previous</span>
            }

            <span>Page @CurrentPage of @TotalPages</span>

            @if (CurrentPage < TotalPages)
            {
                <a href="@PageLink(CurrentPage + 1)">Next</a>
            }
            else
            {
                <span class="disabled">Next</span>
            }
        </div>
    }
}

@code {
    private const int PageSize = 10;

    private IReadOnlyList<ProductListItem> products = [];

    private int totalCount;

    [SupplyParameterFromQuery(Name = "page")]
    private int? Page { get; set; }

    private int CurrentPage => Page is > 0 ? Page.Value : 1;

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(totalCount / (double)PageSize));

    private string Summary => totalCount == 1 ? "1 product in the catalogue." : $"{totalCount} products in the catalogue.";

    protected override async Task OnInitializedAsync()
    {
        var result = await Dispatcher.Get(new GetProductsQuery(CurrentPage, PageSize));

        if (result.Value is not { } page)
        {
            return;
        }

        products = page.Products;
        totalCount = page.TotalCount;
    }

    private static string PageLink(int page) => $"admin/products?page={page}";
}
